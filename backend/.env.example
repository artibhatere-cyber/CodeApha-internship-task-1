# LinguaBridge AI Backend Configuration
PORT=5000
HOST=127.0.0.1
FLASK_DEBUG=True
CORS_ORIGINS=*
MAX_TEXT_LENGTH=5000

# Translation Provider Options: 'auto', 'google', 'google_cloud', 'deepl'
TRANSLATION_PROVIDER=auto

# Optional API Keys for commercial translation services
# (Leave empty to use built-in neural translation engine without requiring any paid API key)
TRANSLATION_API_KEY=your_api_key_here
GOOGLE_PROJECT_ID=your_google_cloud_project_id
DEEPL_API_KEY=your_deepl_api_key_here
